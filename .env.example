# Copy to .env and fill in real values. NEVER commit .env.

# --- Backend (server-only) ---
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Frontend (exposed to the browser) ---
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Market data provider (client feed) ---
VITE_MARKET_REST_URL="https://api.binance.com"
VITE_MARKET_WS_URL="wss://stream.binance.com:9443/ws"
VITE_MARKET_HISTORY_LIMIT="1000"

# --- Market data + AI (server) ---
MARKET_REST_URL="https://api.binance.com"
AI_GATEWAY_URL="https://ai.gateway.lovable.dev/v1/chat/completions"
AI_COACH_MODEL="google/gemini-3.5-flash"
NEWS_SOURCE_BASE_URL="https://www.binance.com"

# --- Paper trading execution assumptions ---
VITE_PAPER_FEE_RATE="0.001"
VITE_PAPER_SLIPPAGE_RATE="0.0005"
